# ── Network ────────────────────────────────────────────────────────
# Chain id of the network the frontend talks to.
#   97  → BSC Testnet (default — preview / development deployments)
#   56  → BSC Mainnet (production deployment)
NEXT_PUBLIC_NETWORK=97

# JSON-RPC endpoint matching NEXT_PUBLIC_NETWORK.
# Public defaults are used if this is empty:
#   testnet → https://bsc-testnet-rpc.publicnode.com
#   mainnet → https://bsc-dataseed.binance.org
# For production, prefer a paid/reliable provider (Alchemy/QuickNode/Ankr).
NEXT_PUBLIC_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# ── Contract addresses ────────────────────────────────────────────
# Must point at contracts deployed on the chain selected above.
# Get them from packages/contracts/deployments/<network>.json after running
# scripts/deploy.js with --network bscTestnet or --network bscMainnet.
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=
NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=
NEXT_PUBLIC_VESTING_ADDRESS=

# ── WalletConnect ─────────────────────────────────────────────────
# WalletConnect v2 — get a Project ID from https://cloud.walletconnect.com.
# Required for the "WalletConnect" option in the wallet picker. The picker
# falls back to disabled state if this is missing.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Access gate / payment (server-only secrets) ───────────────────
# JWT signing key for the access-gate session cookie.
JWT_SECRET=
# Comma-separated, lowercase wallet addresses skipped past the payment step.
EXEMPT_ADDRESSES=
# Comma-separated, lowercase wallet addresses approved through KYC.
KYC_VERIFIED_ADDRESSES=
# Razorpay credentials — use live keys (rzp_live_*) on the production project.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
PAYMENT_AMOUNT_INR=1000
